#compdef skua
# zsh completion for skua.
#
# Install:
#   mkdir -p ~/.zsh/completions
#   cp completions/_skua ~/.zsh/completions/
#   # ensure this is in ~/.zshrc BEFORE `compinit`:
#   #   fpath=(~/.zsh/completions $fpath)
#   #   autoload -Uz compinit && compinit
#
# --profile completes from the same profiles the aws CLI sees, by reading
# ~/.aws/config and ~/.aws/credentials directly (no aws command is run).

_skua_profiles() {
  local -a profiles
  local f cfg="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
  local cred="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
  for f in "$cfg" "$cred"; do
    [[ -r "$f" ]] || continue
    # [profile foo] in config, [foo] in credentials
    profiles+=(${(f)"$(sed -n -E 's/^\[profile[[:space:]]+(.+)\]$/\1/p; s/^\[([^]]+)\]$/\1/p' "$f")"})
  done
  compadd -a profiles
}

_skua_regions() {
  local -a regions
  regions=(
    us-east-1 us-east-2 us-west-1 us-west-2
    ap-northeast-1 ap-northeast-2 ap-northeast-3
    ap-southeast-1 ap-southeast-2 ap-south-1 ap-east-1
    eu-west-1 eu-west-2 eu-west-3 eu-central-1 eu-north-1
    ca-central-1 sa-east-1
  )
  compadd -a regions
}

_skua() {
  _arguments -s \
    '--profile[AWS profile]:profile:_skua_profiles' \
    '--region[AWS region]:region:_skua_regions' \
    '--dry-run[print identity + inventory and exit (no TUI)]' \
    '(-h --help)'{-h,--help}'[show help]'
}

_skua "$@"
